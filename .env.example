# ============================================================
# 【这是模板文件，会提交到公开仓库，只能放占位符！】
# 真实密钥请写到 .env（已被 .gitignore 忽略，不会提交）
# 用法：cp .env.example .env   然后编辑 .env
# ============================================================

# MySQL root 密码
MYSQL_ROOT_PASSWORD=changeme

# AI 模型配置（示例用 Groq，也可换成硅基流动等兼容 OpenAI 协议的服务）
AI_API_KEY=your-api-key-here
# 框架会自动追加 /v1/chat/completions，所以 base-url 不要带末尾的 /v1
AI_BASE_URL=https://api.groq.com/openai
AI_MODEL=openai/gpt-oss-120b

# JWT 签名密钥（生产环境请改为长度 >= 32 的随机字符串）
JWT_SECRET=change-this-secret-in-production-at-least-32-bytes

# 安慰邮件（QQ 邮箱；MAIL_PASSWORD 填「SMTP 授权码」，不是 QQ 登录密码）
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your-qq@qq.com
MAIL_PASSWORD=your-smtp-auth-code
MAIL_FROM_NAME=金凤心理助手
COMFORT_MAIL_ENABLED=true
